# Copy this file to .env and put your key in it. .env is gitignored.
#
#   cp .env.example .env
#   flutter run --dart-define-from-file=.env
#
# The key needs Maps SDK for Android, Maps SDK for iOS and the Routes API
# enabled, plus billing. It must NOT carry an Android or iOS application
# restriction, or the route call is rejected. See README.md.
GOOGLE_MAPS_API_KEY=PASTE_GOOGLE_MAPS_API_KEY_HERE
